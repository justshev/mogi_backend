            ],
            "url": {
              "raw": "{{base_url}}/api/device/session/logout",
              "host": ["{{base_url}}"],
              "path": ["api", "device", "session", "logout"]
            },
            "description": "Menghentikan session secara manual.\n\n**Kegunaan:** Mengakhiri session untuk keamanan.\n\n**Kapan digunakan:** Saat selesai mengontrol device."
          },
          "response": []
        }
      ]
